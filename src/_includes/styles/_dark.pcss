/*
 * ダークモード（第1段階）
 * html.dark が付いているときだけ適用される上書きスタイル。
 * 細かいハードコード色の置き換えは後続作業で行う。
 */
html.dark {
  color-scheme: dark;

  --dm-bg: #16141a;
  --dm-surface: #221f28;
  --dm-text: #e4e1ea;
  --dm-text-muted: #b3afbd;
  --dm-border: #4a4652;
  --dm-link: #9ec5ff;

  body {
    background-color: var(--dm-bg);
    background-image: none;
    color: var(--dm-text);
  }

  /* 面（記事・ヒーロー・カード・目次・検索） */
  article,
  .tdbc-hero,
  .tdbc-card,
  div#search,
  .toc {
    background-color: var(--dm-surface);
  }

  h4,
  blockquote {
    color: var(--dm-text-muted);
  }

  a {
    color: var(--dm-link);
  }

  .tdbc-card a.tdbc-card__title {
    color: #d9a6ff;
  }

  code:not([class*=language]) {
    background-color: var(--dm-bg);
    color: var(--dm-text);
    border-color: var(--dm-border);
  }

  hr {
    border-color: var(--dm-border);
  }

  /*
   * Algolia 検索欄・予測パネル
   * algoliasearchNetlify.css（CDN）の CSS 変数を上書きする。
   * --color-*: netlify-frontend 独自、--aa-*: autocomplete-theme-classic 由来
   */
  .aa-Autocomplete,
  .aa-Panel,
  .aa-DetachedContainer,
  .aa-DetachedFormContainer {
    --color-background: var(--dm-surface);
    --color-text: var(--dm-text);
    --color-selected: #34303d;
    --color-mark: #a99cff;
    --color-input-icon: var(--dm-text-muted);

    --aa-background-color-rgb: 34, 31, 40;
    --aa-input-background-color-rgb: 34, 31, 40;
    --aa-text-color-rgb: 228, 225, 234;
    --aa-muted-color-rgb: 179, 175, 189;
    --aa-primary-color-rgb: 169, 156, 255;
    --aa-selected-color-rgb: 169, 156, 255;
    --aa-panel-border-color-rgb: 74, 70, 82;
    --aa-input-border-color-rgb: 74, 70, 82;
    --aa-panel-shadow: 0 0 0 1px #4a4652, 0 6px 16px -4px rgba(0, 0, 0, .6);

    color: var(--dm-text);
  }
}

/* トップページの「先週の人気記事」などのおすすめ枠・タグ枠 */
html.dark {
  .additional-area {
    background-color: rgba(34, 31, 40, 0.85);
    border-color: var(--dm-border);
    box-shadow: 5px 5px 2px #000;

    h2 {
      border-bottom-color: var(--dm-border);
    }
  }

  .page-ranking {
    border-color: var(--dm-border);
  }
}

/*
 * 注意: Tailwind のクラス名（bg-white など）を含むセレクタは html.dark の中に
 * ネストしないこと。@apply bg-white の参照先として親ルールごと拾われ、
 * 「@apply does not currently support nested CSS」でビルドが失敗する。
 */
html.dark fieldset.tags.bg-white {
  background-color: var(--dm-surface);
  border-color: var(--dm-border);
}

/* 切り替えボタン */
.theme-toggle {
  position: fixed;
  right: 1rem;
  bottom: 1rem;
  z-index: 50;
  width: 2.75rem;
  height: 2.75rem;
  border-radius: 9999px;
  border: 1px solid #adacb7;
  background-color: #fff;
  font-size: 1.25rem;
  line-height: 1;
  cursor: pointer;
  box-shadow: 0 3px 5px rgba(0, 0, 0, .18);
}

html.dark .theme-toggle {
  background-color: var(--dm-surface);
  border-color: var(--dm-border);
}
